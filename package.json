{
  "name": "herdr-agents",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "./test-support/link-deps.sh && bun test --timeout 30000 ./*.test.ts",
    "test:unit": "bun test --timeout 30000 config.test.ts constants.test.ts herdr.test.ts run.test.ts state.test.ts utils.test.ts widget.test.ts",
    "test:integration": "./test-support/link-deps.sh && bun test --timeout 30000 integration.test.ts",
    "test:e2e": "./test-support/link-deps.sh && bun test --timeout 180000 ./e2e/*.test.ts",
    "test:all": "bun run test && bun run test:e2e"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
